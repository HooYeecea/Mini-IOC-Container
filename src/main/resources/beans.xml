<?xml version="1.0" encoding="UTF-8"?>
<beans>
    <property-placeholder location="application.properties"/>
    <component-scan base-package="com.miniioccontainer.demo"/>

    <!-- 纯 XML Bean：没有 @MyComponent，用 property 按名字注入注解 Bean -->
    <bean id="smsService" class="com.miniioccontainer.demo.SmsService">
        <property name="orderService" ref="orderServiceImpl"/>
    </bean>

    <!-- 纯 XML 构造器注入 -->
    <bean id="auditService" class="com.miniioccontainer.demo.AuditService"
          init-method="start" destroy-method="stop">
        <constructor-arg ref="orderServiceImpl"/>
    </bean>

    <!-- 纯 XML 原型：每次 getBean 新建，容器关闭时不销毁 -->
    <bean id="reportJob" class="com.miniioccontainer.demo.ReportJob" scope="prototype"/>

    <bean id="mailSettings" class="com.miniioccontainer.demo.MailSettings">
        <property name="host" value="${mail.host}"/>
        <property name="port" value="${mail.port}"/>
        <property name="ssl" value="${mail.ssl}"/>
    </bean>

    <!-- 懒加载单例：Demo 不取用，启动时不创建，关闭时也不销毁 -->
    <bean id="lazyNote" class="com.miniioccontainer.demo.LazyNote"
          lazy-init="true" init-method="start" destroy-method="stop"/>

    <!-- 同类已有 @MyComponent，注解优先，这条会被跳过 -->
    <bean id="orderServiceFromXml" class="com.miniioccontainer.demo.OrderServiceImpl"/>
</beans>
